{
  "//": "cut from a recorded connection_caps response beside a recorded gitea-swagger response, read 2026-09-18 and 2026-09-16, recorded 2026-09-19; trimmed to the fields the case asserts; owner, repository, login, ids and URLs replaced with the canonical subject; the third route is connection setup's read of the instance's stated maximum page size, cut from a recorded settings_api response, the answer gitea.com gave anonymously, read 2026-10-02",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/version",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "version": "1.27.0"
      }
    },
    {
      "method": "GET",
      "path": "/swagger.v1.json",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "swagger": "2.0",
        "basePath": "/api/v1",
        "info": {
          "title": "Gitea API",
          "version": "1.27.0"
        },
        "paths": {
          "/repos/{owner}/{repo}/actions/runs": {
            "get": {
              "operationId": "getWorkflowRuns",
              "parameters": [
                {
                  "name": "head_sha",
                  "in": "query"
                }
              ]
            }
          },
          "/repos/{owner}/{repo}/actions/runs/{run}/rerun-failed-jobs": {
            "post": {
              "operationId": "rerunFailedWorkflowRun"
            }
          }
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/settings/api",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "max_response_items": 50
      }
    }
  ]
}
