{
  "//": "cut from a recorded repo_affordances response, read 2026-09-18; trimmed to the fields the case asserts; owner, repository, login, ids and URLs replaced with the canonical subject",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/repos/example/example",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "full_name": "example/example",
        "name": "example",
        "owner": {
          "login": "example"
        },
        "description": "Example repository.",
        "html_url": "https://forge.example/example/example",
        "clone_url": "https://forge.example/example/example.git",
        "updated_at": "2026-01-02T00:00:00Z",
        "private": false,
        "archived": false,
        "fork": false,
        "default_branch": "main",
        "has_issues": true,
        "has_pull_requests": true,
        "permissions": {
          "admin": false,
          "push": true,
          "pull": true
        },
        "allow_merge_commits": true,
        "allow_squash_merge": true,
        "allow_rebase": false,
        "allow_rebase_explicit": false,
        "allow_fast_forward_only_merge": false,
        "default_merge_style": "merge"
      }
    }
  ]
}
