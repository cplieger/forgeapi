{
  "//": "cut from a recorded version response beside a recorded forgejo-swagger response and a recorded settings_api response, the answers codeberg.org gave anonymously, read 2026-11-16; trimmed to the fields the case asserts; the API document keeps the runs listing and the whole-run re-run, RerunActionRun, which this product declares from 17",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/version",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "version": "17.0.0-100-2254cb0+gitea-1.22.0"
      }
    },
    {
      "method": "GET",
      "path": "/swagger.v1.json",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "swagger": "2.0",
        "basePath": "/api/v1",
        "info": {
          "title": "Forgejo API",
          "version": "17.0.0-100-2254cb0+gitea-1.22.0"
        },
        "paths": {
          "/repos/{owner}/{repo}/actions/runs": {
            "get": {
              "operationId": "ListActionRuns",
              "parameters": [
                {
                  "name": "head_sha",
                  "in": "query"
                }
              ]
            }
          },
          "/repos/{owner}/{repo}/actions/runs/{run_id}/rerun": {
            "post": {
              "operationId": "RerunActionRun"
            }
          }
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/settings/api",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "max_response_items": 50
      }
    }
  ]
}
