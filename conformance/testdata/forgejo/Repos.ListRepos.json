{
  "//": "cut from a recorded list_repos response beside a recorded phase4d_local response, read 2026-09-18 and 2026-10-02; trimmed to the fields the case asserts; owner, repository, login, ids and URLs replaced with the canonical subject; read on 2026-10-02 on local instances of its current stable and long-term releases with the instance token: the credential's repository listing answers each row's description, page, clone address, update time and its private, archived and fork flags, which this body serves; the last three routes are connection setup, which this case runs first because a page it reads asks for at most the instance's stated maximum page size: the version and the API document as the connection read's own fixture serves them, and that maximum, cut from a recorded settings_api response, the answer codeberg.org gave anonymously, read 2026-10-02",
  "routes": [
    {
      "method": "GET",
      "path": "/api/v1/user/repos",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": [
        {
          "full_name": "example/example",
          "name": "example",
          "owner": {
            "login": "example"
          },
          "description": "Example repository.",
          "html_url": "https://forge.example/example/example",
          "clone_url": "https://forge.example/example/example.git",
          "updated_at": "2026-01-02T00:00:00Z",
          "private": false,
          "archived": false,
          "fork": false,
          "default_branch": "main",
          "has_issues": true,
          "has_pull_requests": true,
          "permissions": {
            "admin": false,
            "push": true,
            "pull": true
          },
          "allow_merge_commits": true,
          "allow_squash_merge": true,
          "allow_rebase": false,
          "allow_rebase_explicit": false,
          "allow_fast_forward_only_merge": false,
          "default_merge_style": "merge"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/version",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "version": "16.0.0+gitea-1.22.0"
      }
    },
    {
      "method": "GET",
      "path": "/swagger.v1.json",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "swagger": "2.0",
        "basePath": "/api/v1",
        "info": {
          "title": "Forgejo API",
          "version": "16.0.0+gitea-1.22.0"
        },
        "paths": {
          "/repos/{owner}/{repo}/actions/runs/{run_id}/logs": {
            "get": {
              "operationId": "repoGetActionRunLogs"
            }
          }
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/settings/api",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "max_response_items": 50
      }
    }
  ]
}
